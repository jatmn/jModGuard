# syntax=docker/dockerfile:1
# Multi-stage build for jmodguard-api.
# Pins Rust 1.96 (lockfile MSRV; edition 2024). JSON API + OAuth only: do not
# embed frontend/ (Bunny serves that from Storage/CDN).
# Local: docker build --secret id=github_token,env=GITHUB_TOKEN -f Dockerfile.api .
FROM rust:1.96-bookworm AS builder
WORKDIR /app
COPY rust-toolchain.toml Cargo.toml Cargo.lock ./
COPY src ./src
COPY crates ./crates
COPY migrations ./migrations
COPY vendor ./vendor
RUN apt-get update \
    && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*
RUN --mount=type=secret,id=github_token,required=true \
    GIT_CONFIG_COUNT=1 \
    GIT_CONFIG_KEY_0=credential.helper \
    GIT_CONFIG_VALUE_0='!f() { echo username=x-access-token; echo password=$(cat /run/secrets/github_token); }; f' \
    CARGO_NET_GIT_FETCH_WITH_CLI=true \
    cargo fetch --locked
RUN CARGO_NET_GIT_FETCH_WITH_CLI=true \
    cargo build --locked --release --bin jmodguard-api --no-default-features --features web

FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 10001 --home /data --shell /usr/sbin/nologin jmodguard \
    && mkdir -p /data \
    && chown jmodguard:jmodguard /data
COPY --from=builder /app/target/release/jmodguard-api /usr/local/bin/jmodguard-api
WORKDIR /data
VOLUME ["/data"]
USER 10001
ENV JMODGUARD_DB_PATH=/data/jmodguard.db
ENV JMODGUARD_CONFIG=/data/config.toml
ENV JMODGUARD_WEB_BIND=0.0.0.0:8080
ENV JMODGUARD_LOG_DIRECTORY=""
# Fail closed unless Bunny/portable remote credentials are present.
ENV JMODGUARD_REQUIRE_REMOTE_DB=1
EXPOSE 8080
ENTRYPOINT ["jmodguard-api"]
