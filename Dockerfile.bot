# Multi-stage build for jmodguard-bot.
# Pins Rust 1.96 (lockfile MSRV; edition 2024). Builds without the `web` feature so the
# Discord binary does not embed the SPA or link axum/tower-sessions.
FROM rust:1.96-bookworm AS builder
WORKDIR /app
COPY Cargo.toml Cargo.lock ./
COPY src ./src
COPY migrations ./migrations
RUN cargo build --locked --release --bin jmodguard-bot --no-default-features

FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 10001 --home /data --shell /usr/sbin/nologin jmodguard \
    && mkdir -p /data \
    && chown jmodguard:jmodguard /data
COPY --from=builder /app/target/release/jmodguard-bot /usr/local/bin/jmodguard-bot
WORKDIR /data
VOLUME ["/data"]
USER 10001
ENV JMODGUARD_DB_PATH=/data/jmodguard.db
ENV JMODGUARD_CONFIG=/data/config.toml
# Container platforms collect stdout/stderr. An empty directory disables
# rolling files; override this if persistent file logs are desired.
ENV JMODGUARD_LOG_DIRECTORY=""
# Fail closed unless Bunny/portable remote credentials are present.
ENV JMODGUARD_REQUIRE_REMOTE_DB=1
# Process-local liveness for Magic Containers HTTP GET/HEAD /health.
ENV JMODGUARD_HEALTH_BIND=0.0.0.0:8080
EXPOSE 8080
ENTRYPOINT ["jmodguard-bot"]
