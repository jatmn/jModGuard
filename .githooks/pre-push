#!/usr/bin/env bash
# Local pre-push: same gates as the Buildkite `test` job.
set -euo pipefail
root="$(git rev-parse --show-toplevel)"
# Drain the ref list Git sends on stdin so the hook cannot SIGPIPE the client.
cat >/dev/null
base_ref="$(git -C "$root" config --get jmodguard.preflight-base 2>/dev/null || true)"
if [ -z "$base_ref" ]; then
  base_ref="origin/main"
fi
exec bash "$root/scripts/ci-preflight.sh" --base "$base_ref"
