# syntax=docker/dockerfile:1
# Multi-stage build for jmodguard-conductor.
# Development control-service image. /health is liveness; /ready is 200 only
# when the control store, OAuth client and operator identity are configured.
# Backup/restore additionally needs JMODGUARD_CONDUCTOR_BACKUP_ROOT (and
# capture/restore paths). Updates are not available in this image.
# Local: docker build --secret id=github_token,env=GITHUB_TOKEN -f Dockerfile.conductor .
FROM rust:1.96-bookworm AS builder
WORKDIR /app
COPY rust-toolchain.toml Cargo.toml Cargo.lock ./
COPY src ./src
COPY crates ./crates
COPY migrations ./migrations
COPY vendor ./vendor
RUN apt-get update \
    && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*
RUN --mount=type=secret,id=github_token,required=true \
    GIT_CONFIG_COUNT=1 \
    GIT_CONFIG_KEY_0=credential.helper \
    GIT_CONFIG_VALUE_0='!f() { echo username=x-access-token; echo password=$(cat /run/secrets/github_token); }; f' \
    CARGO_NET_GIT_FETCH_WITH_CLI=true \
    cargo fetch --locked
RUN CARGO_NET_GIT_FETCH_WITH_CLI=true \
    cargo build --locked --release -p jmodguard-conductor

FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 10001 --home /data --shell /usr/sbin/nologin jmodguard \
    && mkdir -p /data \
    && chown jmodguard:jmodguard /data
COPY --from=builder /app/target/release/jmodguard-conductor /usr/local/bin/jmodguard-conductor
WORKDIR /data
USER 10001
ENV JMODGUARD_CONDUCTOR_BIND=0.0.0.0:8080
ENV JMODGUARD_CONDUCTOR_LOG=info
EXPOSE 8080
ENTRYPOINT ["jmodguard-conductor"]
